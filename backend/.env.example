# Mami's settings. start.sh copies this to backend/.env the first time.
# Fill in the 2 values below, save, and run start.sh again.
# backend/.env stays on your laptop: it is never uploaded to GitHub.

# 1) Your database (Supabase).
#    Supabase -> your project -> Connect -> Direct -> Session pooler -> copy the URI.
#    Put your database password in place of [YOUR-PASSWORD] (no brackets).
#    If the password has symbols, write @ as %40, / as %2F, # as %23, ? as %3F, : as %3A.
DATABASE_URL=

# 2) Your Claude API key: https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# ---- Optional -------------------------------------------------------------

# What Mami calls you.
OWNER_NAME=Sri

# WHOOP (developer-dashboard.whoop.com -> create app).
# Redirect URL to register there: http://localhost:8000/whoop/callback
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=

# Encrypts your stored WHOOP login. start.sh fills this in for you; keep it as is.
APP_ENCRYPTION_KEY=
