# Copy to .env and fill in. Never commit .env.

# Postgres connection (Supabase: Project Settings -> Database -> connection string).
# Use the psycopg driver prefix.
DATABASE_URL=postgresql+psycopg://dm:dm@localhost:5432/daymanager

# Telegram: token from @BotFather. The webhook secret is any random string
# (A-Z, a-z, 0-9, _ and -, 1-256 chars). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Claude API key (needed from batch 3). Claude is the only AI service used.
ANTHROPIC_API_KEY=

# Run the background job worker inside the web process (true in production).
RUN_WORKER=true
