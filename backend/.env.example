# Mami's settings. ./start.sh copies this to backend/.env the first time.
# Fill in the 3 values below, save, and run ./start.sh again.
# backend/.env stays on your laptop: it is never uploaded to GitHub.

# 1) Your Supabase database.
#    Supabase -> your project -> Connect (top bar) -> "Session pooler" -> copy the URI.
#    Replace [YOUR-PASSWORD] with your database password (no brackets).
#    Tip: if you reset the password, use only letters and numbers.
DATABASE_URL=

# 2) Your Telegram bot token, from @BotFather (/newbot).
TELEGRAM_BOT_TOKEN=

# 3) Your Claude API key: https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# ---- Optional -------------------------------------------------------------

# What Mami calls you.
OWNER_NAME=Sri

# WHOOP (developer-dashboard.whoop.com -> create app).
# Redirect URL to register there: http://localhost:8000/whoop/callback
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=

# Encrypts your stored WHOOP login. start.sh fills this in for you; keep it as is.
APP_ENCRYPTION_KEY=
