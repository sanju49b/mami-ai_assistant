# Copy to .env and fill in. Never commit .env.

# Postgres connection (Supabase: Project Settings -> Database -> connection string),
# with the psycopg driver prefix.
DATABASE_URL=postgresql+psycopg://dm:dm@localhost:5432/daymanager

# Public HTTPS address of this backend (WHOOP callback, cookies). On Render this
# is detected automatically; set it only if you use a custom domain.
PUBLIC_BASE_URL=http://localhost:8000

# Secret for the keep-awake pinger URL (cron-job.org). Any random string.
CRON_KEY=

# Telegram: token from @BotFather. Webhook secret = any random string:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Claude API key: the only AI service used.
ANTHROPIC_API_KEY=

# WHOOP app credentials (developer-dashboard.whoop.com). Redirect URL to register:
#   <PUBLIC_BASE_URL>/whoop/callback
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=

# Encrypts stored WHOOP tokens. Generate once and keep it safe:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=

# Run the background worker inside the web process (true in production).
RUN_WORKER=true
